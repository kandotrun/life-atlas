{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "life-atlas",
  "main": "./src/index.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "life-atlas.example.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_COUNTRY": "JP",
    "SESSION_TTL_SECONDS": "86400"
  },
  "secrets": {
    "required": ["AUTH_PASSWORD", "SESSION_SECRET"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LOGIN_GATE",
        "class_name": "GlobalLoginGate"
      }
    ]
  },
  "exports": {
    "GlobalLoginGate": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "ratelimits": [
    {
      "name": "LOGIN_IP_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true
    }
  }
}
